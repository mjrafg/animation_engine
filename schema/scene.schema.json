{
  "$id": "animation-engine/scene.schema.json",
  "title": "Scene",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "background": {
          "default": "#000000",
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "assets": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "attachmentPoints": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      }
    },
    "camera": {
      "default": {
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0
      },
      "type": "object",
      "properties": {
        "x": {
          "default": 0,
          "description": "Pan in world px. 0 = none; +x moves the camera right (the scene slides left). The view centre looks at world (width/2 + x, height/2 + y).",
          "type": "number"
        },
        "y": {
          "default": 0,
          "description": "Pan in world px; +y moves the camera down.",
          "type": "number"
        },
        "scale": {
          "default": 1,
          "description": "Zoom about the view centre: 1 = none, 2 = everything twice as large. Must be > 0.",
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "default": 0,
          "description": "Camera roll in degrees; positive turns the camera clockwise (scene appears counter-clockwise).",
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$",
            "description": "Unique layer id within the scene."
          },
          "asset": {
            "description": "Id of the image asset this layer shows. Omit for a transform-only group node or a `fill` rectangle.",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fill": {
            "description": "Solid colour rectangle filling the layer box (#rrggbb). Used only when there is no asset.",
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "parent": {
            "description": "Transform parent layer id. The layer inherits the parent's position/rotation/scale (and opacity/visibility). It does NOT affect render order: that is `z` only.",
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "parentPoint": {
            "description": "Name of an attachment point on the parent. When set, x/y are offsets from that point instead of from the parent's pivot.",
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
          },
          "x": {
            "default": 0,
            "description": "X of this layer's PIVOT, in the parent's pivot space (canvas pixels for root layers).",
            "type": "number"
          },
          "y": {
            "default": 0,
            "description": "Y of this layer's PIVOT (+y is down).",
            "type": "number"
          },
          "width": {
            "description": "Unscaled box width in px. Defaults to the asset's pixel width (0 for groups). Rendered width = width*scaleX.",
            "type": "number",
            "minimum": 0
          },
          "height": {
            "description": "Unscaled box height in px. Defaults to the asset's pixel height.",
            "type": "number",
            "minimum": 0
          },
          "scaleX": {
            "default": 1,
            "description": "Horizontal scale about the pivot. Negative mirrors.",
            "type": "number"
          },
          "scaleY": {
            "default": 1,
            "description": "Vertical scale about the pivot.",
            "type": "number"
          },
          "anchorX": {
            "default": 0.5,
            "description": "Pivot position inside the box: 0 = left edge, 0.5 = centre, 1 = right edge. Rotation/scale happen around the pivot.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "anchorY": {
            "default": 0.5,
            "description": "Pivot position inside the box: 0 = top edge, 0.5 = centre, 1 = bottom edge.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rotation": {
            "default": 0,
            "description": "Degrees, positive = clockwise, around the pivot. Added to the parent's rotation.",
            "type": "number"
          },
          "opacity": {
            "default": 1,
            "description": "0..1, multiplied by ancestors' opacity.",
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "visible": {
            "default": true,
            "description": "false hides this layer and all its descendants.",
            "type": "boolean"
          },
          "z": {
            "default": 0,
            "description": "GLOBAL render order across the whole scene: higher draws on top; ties keep layer order. A child can have a higher or lower z than its parent or than unrelated layers.",
            "type": "number"
          },
          "mask": {
            "description": "Optional mask: {type:'rect', x,y,width,height, space:'world'|'layer'} or {type:'layer', layer:<id>} (uses that layer's alpha).",
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "layer"
                  },
                  "layer": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
                  },
                  "invert": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "layer"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "rect"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  },
                  "space": {
                    "default": "world",
                    "type": "string",
                    "enum": [
                      "world",
                      "layer"
                    ]
                  },
                  "invert": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            ]
          },
          "attachmentPoints": {
            "description": "Named points {name:{x,y}} in normalised box coordinates (0,0 top-left, 1,1 bottom-right); override the asset's points.",
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "meta": {
            "description": "Free-form notes; ignored by the renderer.",
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "animations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "keyframes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991,
                  "description": "Frame number (integer, 0-based)."
                },
                "value": {
                  "description": "Number for continuous properties; asset id string for `asset`; boolean for `visible`.",
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                },
                "interpolation": {
                  "description": "How to move from THIS keyframe to the next: step | linear | ease-in | ease-out | ease-in-out | cubic-bezier. Default linear (continuous) or step (discrete: asset, visible, z, fill).",
                  "type": "string",
                  "enum": [
                    "step",
                    "linear",
                    "ease-in",
                    "ease-out",
                    "ease-in-out",
                    "cubic-bezier"
                  ]
                },
                "bezier": {
                  "description": "[x1,y1,x2,y2] control points for cubic-bezier (CSS semantics).",
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "frame",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target",
          "property",
          "keyframes"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "startFrame": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "volume": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "canvas",
    "duration"
  ],
  "additionalProperties": false
}
