{
  "$id": "animation-engine/scene.schema.json",
  "title": "Scene",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string"
    },
    "canvas": {
      "type": "object",
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "height": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8192
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 240
        },
        "background": {
          "default": "#000000",
          "type": "string",
          "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
        }
      },
      "required": [
        "width",
        "height",
        "fps"
      ],
      "additionalProperties": false
    },
    "duration": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "assets": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "attachmentPoints": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      }
    },
    "camera": {
      "default": {
        "x": 0,
        "y": 0,
        "scale": 1,
        "rotation": 0
      },
      "type": "object",
      "properties": {
        "x": {
          "default": 0,
          "type": "number"
        },
        "y": {
          "default": 0,
          "type": "number"
        },
        "scale": {
          "default": 1,
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "default": 0,
          "type": "number"
        }
      },
      "additionalProperties": false
    },
    "layers": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
          },
          "asset": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "fill": {
            "type": "string",
            "pattern": "^#(?:[0-9a-fA-F]{3}|[0-9a-fA-F]{4}|[0-9a-fA-F]{6}|[0-9a-fA-F]{8})$"
          },
          "parent": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "parentPoint": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
          },
          "x": {
            "default": 0,
            "type": "number"
          },
          "y": {
            "default": 0,
            "type": "number"
          },
          "width": {
            "type": "number",
            "minimum": 0
          },
          "height": {
            "type": "number",
            "minimum": 0
          },
          "scaleX": {
            "default": 1,
            "type": "number"
          },
          "scaleY": {
            "default": 1,
            "type": "number"
          },
          "anchorX": {
            "default": 0.5,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "anchorY": {
            "default": 0.5,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rotation": {
            "default": 0,
            "type": "number"
          },
          "opacity": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "visible": {
            "default": true,
            "type": "boolean"
          },
          "z": {
            "default": 0,
            "type": "number"
          },
          "mask": {
            "oneOf": [
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "layer"
                  },
                  "layer": {
                    "type": "string",
                    "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
                  },
                  "invert": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "layer"
                ],
                "additionalProperties": false
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "rect"
                  },
                  "x": {
                    "type": "number"
                  },
                  "y": {
                    "type": "number"
                  },
                  "width": {
                    "type": "number",
                    "minimum": 0
                  },
                  "height": {
                    "type": "number",
                    "minimum": 0
                  },
                  "space": {
                    "default": "world",
                    "type": "string",
                    "enum": [
                      "world",
                      "layer"
                    ]
                  },
                  "invert": {
                    "default": false,
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "x",
                  "y",
                  "width",
                  "height"
                ],
                "additionalProperties": false
              }
            ]
          },
          "attachmentPoints": {
            "type": "object",
            "propertyNames": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
            },
            "additionalProperties": {
              "type": "object",
              "properties": {
                "x": {
                  "type": "number"
                },
                "y": {
                  "type": "number"
                }
              },
              "required": [
                "x",
                "y"
              ],
              "additionalProperties": false
            }
          },
          "meta": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {}
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": false
      }
    },
    "animations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "target": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_\\-.]*$"
          },
          "property": {
            "type": "string",
            "minLength": 1
          },
          "keyframes": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "frame": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "value": {
                  "type": [
                    "number",
                    "string",
                    "boolean"
                  ]
                },
                "interpolation": {
                  "type": "string",
                  "enum": [
                    "step",
                    "linear",
                    "ease-in",
                    "ease-out",
                    "ease-in-out",
                    "cubic-bezier"
                  ]
                },
                "bezier": {
                  "type": "array",
                  "prefixItems": [
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number"
                    },
                    {
                      "type": "number",
                      "minimum": 0,
                      "maximum": 1
                    },
                    {
                      "type": "number"
                    }
                  ],
                  "items": false,
                  "minItems": 4,
                  "maxItems": 4
                }
              },
              "required": [
                "frame",
                "value"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "target",
          "property",
          "keyframes"
        ],
        "additionalProperties": false
      }
    },
    "audio": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "src": {
            "type": "string",
            "minLength": 1
          },
          "startFrame": {
            "default": 0,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "volume": {
            "default": 1,
            "type": "number",
            "minimum": 0,
            "maximum": 10
          }
        },
        "required": [
          "src"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "canvas",
    "duration"
  ],
  "additionalProperties": false
}
