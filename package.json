{
  "name": "animation-engine",
  "version": "1.0.0",
  "description": "Deterministic layered 2D animation engine (scene JSON -> frames -> FFmpeg -> MP4)",
  "main": "src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude \"tests/mcp/**\"",
    "ae": "tsx src/cli.ts",
    "example:assets": "tsx examples/kitchen/generate-assets.ts && tsx examples/kitchen/process-assets.ts",
    "example:render": "tsx examples/kitchen/render.ts",
    "schema": "tsx scripts/export-schema.ts",
    "example:feedback": "tsx examples/kitchen/feedback-loop.ts",
    "example:all": "npm run example:assets && tsx examples/kitchen/build-scene.ts && npm run example:feedback && npm run example:render",
    "playground": "tsx examples/playground/generate-assets.ts && tsx examples/playground/process-assets.ts && tsx examples/playground/build-scene.ts && tsx src/cli.ts video examples/playground/scene.json examples/playground/out/playground.mp4",
    "build:mcp": "esbuild mcp/src/main.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/video-engine-mcp.mjs --external:@napi-rs/canvas --external:sharp --external:ffmpeg-static --banner:js=\"import{createRequire as __cr}from\\\"node:module\\\";const require=__cr(import.meta.url);\"",
    "mcp": "node dist/video-engine-mcp.mjs",
    "mcp:dev": "tsx mcp/src/main.ts",
    "test:mcp": "npm run build:mcp && vitest run tests/mcp",
    "test:all": "npm test && npm run test:mcp"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mjrafg/animation_engine.git"
  },
  "author": "",
  "license": "UNLICENSED",
  "bugs": {
    "url": "https://github.com/mjrafg/animation_engine/issues"
  },
  "homepage": "https://github.com/mjrafg/animation_engine#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@napi-rs/canvas": "^1.0.9",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  },
  "type": "module",
  "bin": {
    "video-engine-mcp": "bin/video-engine-mcp.js"
  },
  "engines": {
    "node": ">=20"
  }
}
